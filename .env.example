# Do not commit real .env files.

# Admin login. Use real values only in local/private deployment env files.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_TTL_MS=43200000

# Mini program WeChat login. Keep the real secret only on the server.
WECHAT_MINIAPP_APPID=
WECHAT_MINIAPP_SECRET=

# MySQL user database for mini program login.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=baxiaota
DB_USER=app_user
DB_PASSWORD=
DB_CONNECTION_LIMIT=5

# Token signing. Production must use a private random value.
JWT_SECRET=
USER_SESSION_TTL_MS=2592000000

# Phone identity hashing. Used to create HMAC-SHA256 hashes for phone bindings.
# Do not store phone plaintext in repository files or frontend code.
PHONE_HASH_SECRET=
