NODE_ENV=development
ADMIN_API_TOKEN=dev-admin-token
JWT_SECRET=replace-with-a-private-jwt-secret
# Production must use an absolute path outside the release directory.
# WORD_DATA_PATH=/absolute/persistent/path/words.json
VIRTUAL_PAYMENT_ENABLED=false
VIRTUAL_PAYMENT_ENV=sandbox

# Invitation bearer credentials require two independent server-only secrets of at least 32 bytes.
# Generate separate random values. In particular, never reuse
# WECHAT_VIRTUAL_PAYMENT_SANDBOX_APP_KEY or WECHAT_VIRTUAL_PAYMENT_PRODUCTION_APP_KEY,
# nor JWT, phone, campaign, admin, redemption, order, mini-app, or other business secrets.
# INVITATION_TOKEN_HMAC_SECRET=generate-an-independent-value-with-openssl-rand-hex-32
# INVITATION_CANDIDATE_HMAC_SECRET=generate-a-different-independent-value-with-openssl-rand-hex-32
# Both invitation secrets must be independent from WECHAT_SECRET, WECHAT_MINIAPP_SECRET, payment AppKeys, and all other server secrets.

# Production must override ADMIN_API_TOKEN with a private, non-default value.
# Production must set NODE_ENV=production and JWT_SECRET to a private stable value.
# Only when VIRTUAL_PAYMENT_ENABLED=true, select exactly one environment and configure
# that environment's server-only variables. Never use VUE_APP_* or commit real values.
# sandbox derives message/request Env=1 and query_order env_type=2.
# WECHAT_VIRTUAL_PAYMENT_SANDBOX_OFFER_ID=
# WECHAT_VIRTUAL_PAYMENT_SANDBOX_PRODUCT_ID=
# WECHAT_VIRTUAL_PAYMENT_SANDBOX_APP_KEY=
# VIRTUAL_PAYMENT_SANDBOX_USER_IDS=
# VIRTUAL_PAYMENT_SANDBOX_TEST_PRODUCT_ENABLED=false
# WECHAT_VIRTUAL_PAYMENT_SANDBOX_TEST_PRODUCT_ID=
# production requires NODE_ENV=production, derives Env=0/env_type=1, and only uses ¥30.
# WECHAT_VIRTUAL_PAYMENT_PRODUCTION_OFFER_ID=
# WECHAT_VIRTUAL_PAYMENT_PRODUCTION_PRODUCT_ID=
# WECHAT_VIRTUAL_PAYMENT_PRODUCTION_APP_KEY=
# Production message delivery must be enabled in AES JSON mode. Values stay server-only.
# VIRTUAL_PAYMENT_WECHAT_MESSAGE_ENABLED=false
# WECHAT_VIRTUAL_PAYMENT_MESSAGE_TOKEN=
# WECHAT_VIRTUAL_PAYMENT_MESSAGE_ORIGINAL_ID=
# WECHAT_VIRTUAL_PAYMENT_MESSAGE_FORMAT=json
# WECHAT_VIRTUAL_PAYMENT_MESSAGE_MODE=aes
# WECHAT_VIRTUAL_PAYMENT_MESSAGE_ENCODING_AES_KEY=
# WECHAT_MINIAPP_APPID=
# Do not commit real .env files.
