ADMIN_API_TOKEN=dev-admin-token

# Production must override ADMIN_API_TOKEN with a private, non-default value.
# Do not commit real .env files.

# Mini program WeChat login. Keep the real secret only on the server.
WECHAT_MINIAPP_APPID=
WECHAT_MINIAPP_SECRET=

# MySQL user database for mini program login.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=baxiaota
DB_USER=app_user
DB_PASSWORD=
DB_CONNECTION_LIMIT=5

# Token signing. Production must use a private random value.
JWT_SECRET=
USER_SESSION_TTL_MS=2592000000
